@echo off
setlocal EnableDelayedExpansion

echo =============================================
echo   Video Storage AI -- Build Script
echo =============================================
echo.

:: Resolve script directory (repo root)
set "ROOT=%~dp0"
set "API_DIR=%ROOT%api"
set "RELEASE_DIR=%ROOT%release"

:: Read version from VERSION file and auto-increment patch
set /p VERSION=<"%ROOT%VERSION"
if "%VERSION%""=="" set VERSION=0.1.0

:: Parse major.minor.patch and increment patch
for /f "tokens=1-3 delims=." %%a in ("%VERSION%") do (
    set "MAJOR=%%a"
    set "MINOR=%%b"
    set /a "PATCH=%%c+1"
)
set "VERSION=%MAJOR%.%MINOR%.%PATCH%"

:: Write incremented version back to VERSION file
echo %VERSION%> "%ROOT%VERSION"

echo Version: %VERSION% (auto-incremented patch)
echo.

:: ?? 0. Stop services ??????????????????????????
echo [0/5] Stopping services...
sc stop VideoStorageAI-API > nul 2>&1
sc stop VideoStorageAI-Web > nul 2>&1
timeout /t 3 /nobreak > nul
echo       Services stopped.
echo.

:: ?? 1. Clean release folder ??????????????????
echo [1/5] Cleaning release folder...
if exist "%RELEASE_DIR%" rmdir /s /q "%RELEASE_DIR%"
mkdir "%RELEASE_DIR%"

:: ?? 2. Build frontend ????????????????????????
echo [2/5] Building frontend (npm run build)...
cd /d "%ROOT%"
call npm run build
if %ERRORLEVEL% neq 0 (
    echo.
    echo ERROR: Frontend build failed.
    exit /b 1
)

:: ?? 3. Build Go binaries ?????????????????????
set LDFLAGS=-s -w -X github.com/brixen96/video-storage-ai/internal/config.Version=%VERSION%
echo       LDFLAGS: %LDFLAGS%
echo       Version will be: %VERSION%

echo [3/5] Building API server (VideoStorageAI-API.exe)...
cd /d "%API_DIR%"
set CGO_ENABLED=1
set GOOS=windows
set GOARCH=amd64
go build -ldflags "%LDFLAGS%" -o "%RELEASE_DIR%\VideoStorageAI-API.exe" ./cmd/server
if %ERRORLEVEL% neq 0 (
    echo.
    echo ERROR: API server build failed.
    exit /b 1
)

echo [3/5] Building Web server (VideoStorageAI-Web.exe)...
go build -ldflags "%LDFLAGS%" -o "%RELEASE_DIR%\VideoStorageAI-Web.exe" ./cmd/web
if %ERRORLEVEL% neq 0 (
    echo.
    echo ERROR: Web server build failed.
    exit /b 1
)

:: Copy VERSION file next to the binary so the web server can read it
copy "%ROOT%VERSION" "%RELEASE_DIR%\VERSION" > nul 2>&1

:: ?? 3b. Generate release .env with absolute AppData paths ??
echo [3b/5] Writing release\.env with your user AppData paths...
set "APPDATA_FWD=%APPDATA:\=/%"
set "DATA_DIR=%APPDATA_FWD%/Video Storage AI"
(
echo # Auto-generated by build.bat -- do not edit manually
echo DATABASE_PATH="%DATA_DIR%/videos.db"
echo THUMBNAIL_DIR="%DATA_DIR%/thumbnails"
echo PERFORMER_DIR="%DATA_DIR%/performers"
echo ASSETS_BASE_DIR="%DATA_DIR%"
echo SERVER_PORT=8080
echo SERVER_HOST=localhost
echo SERVER_MODE=release
) > "%RELEASE_DIR%\.env"

:: ?? 4. Copy frontend dist ????????????????????
echo [4/5] Copying frontend dist...
xcopy /E /I /Q "%ROOT%dist" "%RELEASE_DIR%\dist\"
if %ERRORLEVEL% neq 0 (
    echo.
    echo ERROR: Failed to copy dist folder.
    exit /b 1
)

:: ?? 5. Restart services ???????????????????????
echo [5/5] Restarting services...
sc start VideoStorageAI-API > nul 2>&1
sc start VideoStorageAI-Web > nul 2>&1
timeout /t 3 /nobreak > nul
echo       Services started.
echo.

:: ?? Summary ???????????????????????????????????
echo =============================================
echo   Build complete!  v%VERSION%
echo =============================================
echo.
echo   http://localhost:3000
