{
  "manifest_version": 3,
  "name": "VideoStorageAI Companion Bridge",
  "version": "1.0.0",
  "description": "Lets your VideoStorageAI Companion see and work with your browsing: current page, downloads, history and bookmarks. All data goes only to your own local backend (127.0.0.1:8080).",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "downloads",
    "history",
    "bookmarks",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "videostorageai-bridge@brixen96",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent",
          "websiteActivity",
          "bookmarksInfo",
          "searchTerms"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
